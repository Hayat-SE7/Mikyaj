// Mikyaj Beauty Parlor - Engineering Specification Rev. 5 & SRS v2.1 Database Schema
// Database target: PostgreSQL (DEC-003, DEC-033)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  OWNER
}

enum BookingStatus {
  DRAFT
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  REJECTED
  RESCHEDULE_REQUESTED
  RESCHEDULED
}

enum NotificationChannel {
  email
  whatsapp
}

enum OutboxStatus {
  PENDING
  CLAIMED
  PROCESSING
  SENT
  FAILED
  DEAD_LETTER
}

enum RefundStatus {
  none
  partial
  full
  pending
}

model User {
  id              String           @id @default(uuid())
  email           String?          @unique
  phone           String?          @unique
  passwordHash    String?          @map("password_hash")
  role            Role             @default(CUSTOMER)
  permissions     Json?            // RBAC capabilities object (DEC-003, §7)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  customerProfile CustomerProfile?

  @@map("users")
}

model CustomerProfile {
  id            String    @id @default(uuid())
  userId        String?   @unique @map("user_id")
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  email         String
  phone         String    // Normalized E.164 (BR-017, AUD-04)
  totalBookings Int       @default(0) @map("total_bookings")
  totalSpendPKR Int       @default(0) @map("total_spend_pkr")
  notes         Json?     // Array of stylist/desk internal notes
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  bookings      Booking[]

  @@index([phone])
  @@index([email])
  @@map("customer_profiles")
}

model Staff {
  id             String               @id @default(uuid())
  name           String
  role           String
  experience     String
  experienceYears Int                 @default(3) @map("experience_years")
  rating         Float                @default(5.0)
  reviewsCount   Int                  @default(0) @map("reviews_count")
  avatarUrl      String               @map("avatar_url")
  bookable       Boolean              @default(true)
  createdAt      DateTime             @default(now()) @map("created_at") // Deterministic tie-breaker (DEC-005, AUD-02)
  updatedAt      DateTime             @updatedAt @map("updated_at")
  qualifications StaffQualification[]
  schedules      StaffSchedule[]
  breaksLeave    StaffBreakLeave[]
  bookings       Booking[]
  bookingItems   BookingItem[]

  @@map("staff")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  orderIndex  Int       @default(0) @map("order_index")
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  services    Service[]

  @@map("categories")
}

model Service {
  id             String               @id @default(uuid())
  categoryId     String               @map("category_id")
  category       Category             @relation(fields: [categoryId], references: [id])
  title          String
  slug           String               @unique
  duration       Int                  // minutes
  price          Int                  // stored as integer PKR (DEC-023, AUD-01)
  description    String
  imageUrl       String               @map("image_url")
  active         Boolean              @default(true) // Soft-delete only (BR-C-018, BR-013)
  popular        Boolean              @default(false)
  rating         Float                @default(5.0)
  reviewsCount   Int                  @default(0) @map("reviews_count")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  qualifications StaffQualification[]
  bookings       Booking[]
  bookingItems   BookingItem[]

  @@index([categoryId])
  @@map("services")
}

model StaffQualification {
  id        String   @id @default(uuid())
  staffId   String   @map("staff_id")
  serviceId String   @map("service_id")
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([staffId, serviceId])
  @@map("staff_qualifications")
}

model StaffSchedule {
  id        String   @id @default(uuid())
  staffId   String   @map("staff_id")
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayOfWeek Int      @map("day_of_week") // 0 = Sunday, 1 = Monday ... 6 = Saturday
  startTime String   @map("start_time")  // HH:MM
  endTime   String   @map("end_time")    // HH:MM
  isWorking Boolean  @default(true) @map("is_working")

  @@unique([staffId, dayOfWeek])
  @@map("staff_schedules")
}

model StaffBreakLeave {
  id            String   @id @default(uuid())
  staffId       String   @map("staff_id")
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type          String   // 'BREAK' | 'LEAVE'
  startDatetime DateTime @map("start_datetime")
  endDatetime   DateTime @map("end_datetime")
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([staffId, startDatetime, endDatetime])
  @@map("staff_breaks_leave")
}

model BranchHours {
  id        String  @id @default(uuid())
  branchId  String  @map("branch_id")
  dayOfWeek Int     @map("day_of_week")
  openTime  String  @map("open_time")
  closeTime String  @map("close_time")
  isClosed  Boolean @default(false) @map("is_closed")
  timezone  String  @default("Asia/Karachi") // (DEC-022)

  @@unique([branchId, dayOfWeek])
  @@map("branch_hours")
}

model Booking {
  id                String                 @id @default(uuid())
  reference         String                 @unique // MK-XXXXXX format (BR-C-016, DEC-024, AUD-03)
  customerId        String?                @map("customer_id")
  customer          CustomerProfile?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  guestName         String                 @map("guest_name")
  guestEmail        String                 @map("guest_email")
  guestPhone        String                 @map("guest_phone") // Normalized E.164 (BR-017)
  serviceId         String                 @map("service_id")
  service           Service                @relation(fields: [serviceId], references: [id])
  stylistId         String                 @map("stylist_id")
  stylist           Staff                  @relation(fields: [stylistId], references: [id])
  branchId          String                 @map("branch_id")
  bookingDate       String                 @map("booking_date") // YYYY-MM-DD
  startTime         String                 @map("start_time")   // HH:MM
  endTime           String                 @map("end_time")     // HH:MM
  duration          Int                    // minutes
  totalPrice        Int                    @map("total_price")  // PKR, locked at confirmation (BR-C-017, DEC-023)
  currency          String                 @default("PKR")
  tax               Int                    @default(0)
  specialRequests   String?                @map("special_requests")
  status            BookingStatus          @default(PENDING)
  rescheduleCount   Int                    @default(0) @map("reschedule_count") // max 2 self-service (BR-C-020, DEC-004)
  refundStatus      RefundStatus           @default(none) @map("refund_status") // (DEC-026)
  cancellationReason String?               @map("cancellation_reason")
  createdAt         DateTime               @default(now()) @map("created_at") // Stored in UTC (DEC-022)
  updatedAt         DateTime               @updatedAt @map("updated_at")
  items             BookingItem[]
  statusHistory     BookingStatusHistory[]
  reviews           Review[]
  outboxJobs        NotificationOutbox[]

  @@index([bookingDate])
  @@index([stylistId, bookingDate])
  @@index([status])
  @@map("bookings")
}

model BookingItem {
  id        String   @id @default(uuid())
  bookingId String   @map("booking_id")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId String   @map("service_id")
  service   Service  @relation(fields: [serviceId], references: [id])
  staffId   String   @map("staff_id")
  staff     Staff    @relation(fields: [staffId], references: [id])
  price     Int
  duration  Int
  createdAt DateTime @default(now()) @map("created_at")

  @@map("booking_items")
}

model BookingStatusHistory {
  id         String        @id @default(uuid())
  bookingId  String        @map("booking_id")
  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus BookingStatus @map("from_status")
  toStatus   BookingStatus @map("to_status")
  actor      String        // e.g. 'Customer: Hayat Khan', 'Admin: Front Desk'
  reason     String?       // Mandatory on overrides (BR-C-008, AUD-08)
  timestamp  DateTime      @default(now())

  @@index([bookingId])
  @@map("booking_status_history")
}

model BookingReservation {
  id          String   @id @default(uuid())
  slotKey     String   @unique @map("slot_key") // stylistId_date_startTime
  staffId     String   @map("staff_id")
  bookingDate String   @map("booking_date")
  startTime   String   @map("start_time")
  endTime     String   @map("end_time")
  expiresAt   DateTime @map("expires_at") // Short-lived hold during commit (F-02)

  @@index([staffId, bookingDate])
  @@map("booking_reservations")
}

model Review {
  id          String   @id @default(uuid())
  bookingId   String   @unique @map("booking_id") // exactly one review per booking (BR-C-009, BR-014)
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId  String?  @map("customer_id")
  rating      Int      // 1-5 (VR-008)
  comment     String?
  isModerated Boolean  @default(true) @map("is_moderated")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

model NotificationOutbox {
  id             String              @id @default(uuid())
  bookingEventId String              @map("booking_event_id")
  bookingId      String              @map("booking_id")
  booking        Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingRef     String              @map("booking_ref")
  channel        NotificationChannel // email or whatsapp (DEC-011, ARCH-017)
  event          String              // booking_created, booking_accepted, etc.
  templateName   String              @map("template_name")
  recipient      String              // email or E.164 phone
  payload        Json
  status         OutboxStatus        @default(PENDING)
  attemptCount   Int                 @default(0) @map("attempt_count") // max 5 (DEC-006)
  nextAttemptAt  DateTime?           @map("next_attempt_at") // 1m->5m->30m->2h->12h (DEC-007, AUD-07)
  lockedBy       String?             @map("locked_by")
  lockedAt       DateTime?           @map("locked_at") // 2 min TTL
  lastError      String?             @map("last_error")
  createdAt      DateTime            @default(now()) @map("created_at")
  sentAt         DateTime?           @map("sent_at")
  logs           NotificationLog[]

  @@unique([bookingEventId, channel]) // Structurally enforces 1 job per event per channel (ARCH-017)
  @@index([status, channel])
  @@index([nextAttemptAt])
  @@map("notification_outbox")
}

model NotificationLog {
  id        String             @id @default(uuid())
  outboxId  String             @map("outbox_id")
  outbox    NotificationOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  status    OutboxStatus
  error     String?
  timestamp DateTime           @default(now())

  @@map("notification_log")
}

model ProcessedWebhookEvent {
  id              String   @id @default(uuid())
  providerEventId String   @unique @map("provider_event_id") // WhatsApp webhook dedupe
  channel         String
  processedAt     DateTime @default(now()) @map("processed_at")

  @@map("processed_webhook_events")
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  key            String   @unique // Client UUID v4 (DEC-010, AUD-05)
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at") // 24h TTL

  @@index([expiresAt])
  @@map("idempotency_keys")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String   @map("actor_id")
  actorName   String   @map("actor_name")
  actorRole   String   @map("actor_role") // 'Owner' | 'Admin' | 'Customer'
  action      String   // e.g. POLICY_OVERRIDE_CANCELLATION, STAFF_SCHEDULE_UPDATE
  entityType  String   @map("entity_type") // 'Booking' | 'Service' | 'Staff' | 'Setting' | 'Customer'
  entityId    String   @map("entity_id")
  reason      String?  // mandatory on overrides
  beforeState String?  @map("before_state")
  afterState  String?  @map("after_state")
  timestamp   DateTime @default(now()) // Immutable, append-only (DEC-020)

  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("audit_logs")
}
